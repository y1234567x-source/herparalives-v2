# Alibaba Bailian (server only). Used by "我的平行人生" generation.
# Inject via .env.local (gitignored) or the hosting dashboard — never commit it.
DASHSCOPE_API_KEY=
QWEN_STORY_MODEL=qwen-plus
QWEN_STRUCTURED_MODEL=qwen-plus
# Optional: custom OpenAI-compatible endpoint for local mock testing.
LLM_BASE_URL=

# Optional: Supabase Auth with an SMS provider enabled in its dashboard.
# Both values stay on the server. With these unset, the app offers guest play.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Prefer the modern publishable key. ANON_KEY remains supported for compatibility.
SUPABASE_PUBLISHABLE_KEY=
# Enable only after the phone provider, OTP expiry/rate limits and SMS hook work.
SMS_LOGIN_ENABLED=false

# Supabase Auth > Hooks > Send SMS. Store the signing secret only on the server.
SUPABASE_SMS_HOOK_SECRET=
# Alibaba Cloud PNVS "SMS Authentication" (not the separate SMS product).
# Use a RAM key with only the necessary PNVS permission, never your root key.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# Must match Supabase Phone OTP expiry (300 seconds by default for this app).
SMS_OTP_MINUTES=5
